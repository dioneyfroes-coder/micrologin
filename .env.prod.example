# ===================================================================
# CONFIGURAÇÃO DE PRODUÇÃO - Exemplo de .env.prod
# ===================================================================
# Copie este arquivo para .env.prod e preencha com valores REAIS.
# NUNCA comite o arquivo .env.prod real no repositório.
# Use um gerenciador de segredos (Vault, GitHub Secrets, KMS) na prática.
# Variáveis listadas são as efetivamente consumidas pela aplicação
# (src/interfaces/config/*.ts) e pelo docker-compose.prod.yml.

# ===================================================================
# DOCKER REGISTRY (usado pelo docker-compose.prod.yml)
# ===================================================================
REGISTRY=ghcr.io/SEU-USUARIO
IMAGE_NAME=auth-service
VERSION=latest
# Opcional: o snapshot usa hostname do container quando não definido.
# INSTANCE_ID=auth-service-a

# URL pública da API (termina no proxy/orquestrador). Usada pelo healthcheck
# pós-deploy do scripts/deploy.sh (produção).
PROD_BASE_URL=https://api.suaempresa.com

# APP_PORT publica HTTP e redireciona para HTTPS na porta padrão 443.
# PROXY_TLS_CERT_DIR deve conter fullchain.pem e privkey.pem provisionados fora
# do git (ou montados pelo gerenciador de certificados do host).
APP_PORT=80
PROXY_TLS_CERT_DIR=./secrets/tls

# ===================================================================
# APLICAÇÃO
# ===================================================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# TLS é terminado no proxy/orquestrador, então o app roda em HTTP.
SSL_ENABLED=false
# Um salto: o nginx sobrescreve X-Forwarded-For com o IP real do cliente e é o
# único que alcança a rede da aplicação. `true` (confiar em toda a cadeia) faz o
# app recusar o arranque, porque nada dentro do processo consegue verificar se
# existe um proxy reescrevendo esse cabeçalho.
TRUST_PROXY=1
# Só se a sua topologia NÃO tem proxy reverso reescrevendo X-Forwarded-For mas o
# app ainda assim não é alcançável por fora da rede confiável:
# TRUST_PROXY_ALLOW_UNRESTRICTED=true
# Se o app precisar servir HTTPS sozinho, informe os certificados e
# monte-os no container:
# SSL_KEY_PATH=/app/certs/server.key
# SSL_CERT_PATH=/app/certs/server.crt

# O container já é uma unidade escalável (docker compose --scale/kubernetes);
# deixe o clustering interno desligado.
CLUSTER_ENABLED=false
# CLUSTER_WORKERS=4
# CLUSTER_MAX_WORKERS=8
# CLUSTER_RESPAWN_DELAY=1000

# ===================================================================
# TIMEOUTS
# ===================================================================
SERVER_TIMEOUT=30000
HTTP_HEADERS_TIMEOUT=15000
HTTP_REQUEST_TIMEOUT=30000
HTTP_KEEP_ALIVE_TIMEOUT=5000
HTTP_CONNECTIONS_CHECKING_INTERVAL=1000
HTTP_LISTEN_BACKLOG=1024
HTTP_MAX_REQUESTS_PER_SOCKET=1000
HTTP_MAX_HEADERS_COUNT=100
GRACEFUL_SHUTDOWN_TIMEOUT=10000
NET_CORE_SOMAXCONN=4096

# ===================================================================
# MONGODB
# ===================================================================
# Dois modos válidos; o app recusa o arranque em produção sem credencial (D18).
#
# MODO A — Mongo do próprio docker-compose.prod.yml (padrão):
#   o serviço `mongodb` cria o usuário da aplicação na primeira inicialização do
#   volume, em authSource=admin, com papel readWrite só sobre o banco do serviço.
#   A URI não carrega senha: ela vem por arquivo.
# URI_MONGODB=mongodb://mongodb:27017/auth_prod
# MONGODB_USER=auth-service
# MONGODB_PASSWORD_PATH=/run/secrets/deps/mongo-app-password
# MONGODB_AUTH_SOURCE=admin
#
# MODO B — Mongo gerenciado (Atlas etc.):
#   apague o serviço `mongodb` do compose, aponte a URI para o host gerenciado e
#   exija TLS. A senha continua fora da URI, quando o provedor aceitar usuário
#   separado; se ela vier embutida na URI, MONGODB_USER/PASSWORD ficam vazias.
# URI_MONGODB=mongodb+srv://cluster.mongodb.net/auth-service
# MONGODB_USER=auth-service
# MONGODB_PASSWORD_PATH=/run/secrets/deps/mongo-app-password
# MONGODB_TLS=true
URI_MONGODB=mongodb://mongodb:27017/auth_prod
MONGODB_USER=auth-service
MONGODB_PASSWORD_PATH=/run/secrets/deps/mongo-app-password
MONGODB_AUTH_SOURCE=admin
MONGODB_MAX_POOL_SIZE=25
MONGODB_TIMEOUT=10000
# MONGODB_SOCKET_TIMEOUT=45000
# MONGODB_TLS=true

# ===================================================================
# REDIS (CACHE, BLACKLIST DE JWT E RATE LIMIT)
# ===================================================================
# MODO A — Redis do próprio compose (padrão): ACL por arquivo, com
# `user default off`. A senha vem por arquivo, não na URL.
# REDIS_URL=redis://redis:6379/0
# REDIS_USERNAME=auth-service
# REDIS_PASSWORD_PATH=/run/secrets/deps/redis-password
#
# MODO B — Redis gerenciado (ElastiCache etc.): apague o serviço `redis` do
# compose, use `rediss://` e/ou REDIS_TLS=true.
REDIS_URL=redis://redis:6379/0
REDIS_USERNAME=auth-service
REDIS_PASSWORD_PATH=/run/secrets/deps/redis-password
REDIS_ENABLED=true
# Fallback usado apenas quando REDIS_URL não está definida:
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
REDIS_TTL=3600
# REDIS_TLS=true

# ===================================================================
# TRANSPORTE ATÉ AS DEPENDÊNCIAS (decisão D18)
# ===================================================================
# Binário de propósito: TLS no caminho OU rede dedicada sem porta publicada.
# O compose padrão usa a rede `deps-network` (internal, sem gateway) e por isso
# declara o isolamento aqui. Ao apontar para serviço gerenciado, troque por
# MONGODB_TLS/REDIS_TLS e remova esta linha — as duas ao mesmo tempo não é uma
# opção, e "nenhuma das duas" não arranca.
DEPENDENCY_NETWORK_ISOLATED=true

# ===================================================================
# SEGURANÇA - JWT
# ===================================================================
# Algoritmo de assinatura. ES256 (assimetrico) e o unico aceito em producao:
# quem assina tem a chave privada, quem verifica so a publica. HS256 exigiria
# que todo processo que valida um token guardasse o segredo de assinatura.
JWT_ALGORITHM=ES256

# Gere o par no diretorio do HOST, e NAO em /run/secrets: esse e o caminho
# DENTRO do container. O comando precisa de --for-container porque o app roda
# como uid 1001 (nodeuser) e o bind mount carrega o dono do host — um par em
# modo 600 do usuario que provisionou seria ilegivel la dentro, e o servico
# recusaria arrancar dizendo que a chave falta, quando ela esta ali.
#   scripts/generate-jwt-keys.sh /run/secrets-host/jwt 2026-q3 --for-container
# A chave privada nao vira texto de configuracao: monte-a como arquivo.
#
# JWT_ES256_KEYS_DIR e o diretorio do HOST com o par. O compose monta esse
# diretorio em /run/secrets (somente leitura) e o app le pelo caminho.
JWT_ES256_KEYS_DIR=/run/secrets-host/jwt
JWT_ES256_KID=2026-q3
JWT_ES256_PRIVATE_KEY_PATH=/run/secrets/jwt-es256-private.pem
JWT_ES256_PUBLIC_KEY_PATH=/run/secrets/jwt-es256-public.pem

# Rotacao de chave (opcional, e temporaria por definicao): a chave anterior
# continua verificando os tokens que ainda estao vivos, entao trocar a chave
# nao derruba quem esta logado. Depois que os tokens da chave antiga expiram,
# remova estas duas variaveis.
# JWT_ES256_PREVIOUS_KID=2026-q2
# JWT_ES256_PREVIOUS_PUBLIC_KEY_PATH=/run/secrets/jwt-es256-public-anterior.pem

# Alternativa sem arquivo, para quem nao tem volume de secrets: o PEM com
# \n literal ou o base64 do PEM. Menos recomendado: chave em texto de config.
# JWT_ES256_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n
# JWT_ES256_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----\n

JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_ISSUER=auth-service
JWT_AUDIENCE=api-users

# Legado HS256 (apenas dev/test; producao recusa no STARTUP):
# JWT_SECRET=troque-por-uma-chave-aleatoria-de-pelo-menos-48-bytes
# JWT_REFRESH_SECRET=outra-chave-aleatoria-diferente-da-anterior-48-bytes

# ===================================================================
# SEGURANÇA - SESSÃO / REVOGAÇÃO
# ===================================================================
# Política quando o Redis (blacklist) está indisponível:
#   false (padrão em produção) = fail-closed: nega operações que dependem
#                                de revogação, preservando a segurança.
#   true = fail-open: mantém disponibilidade, aceitando tokens revogados.
SESSION_FAIL_OPEN=false

# ===================================================================
# SEGURANÇA - HASH DE SENDA (argon2id)
# ===================================================================
# O serviço usa argon2id (não bcrypt; BCRYPT_SALT_ROUNDS abaixo é resíduo de
# configuração e não tem efeito).
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=1
ARGON2_PARALLELISM=1

# Teto de hashes argon2id SIMULTÂNEOS por processo. É o número que o orçamento
# de memória multiplica por ARGON2_MEMORY_COST para decidir se o container
# aguenta (768 MiB), então mudar um sem o outro recusa o arranque.
#
# 8 é a concorrência que o serviço entrega sem fila perceptível, e com m=64MiB
# são 512 MiB dos 768 MiB. Subir este número sem baixar ARGON2_MEMORY_COST
# derruba o serviço no arranque; baixar sem querer faz o login enfileirar.
ARGON2_MAX_CONCURRENCY=8

# Profundidade da fila de espera antes de recusar com 503. Hash argon2 é
# trabalho legítimo, então o excesso espera em vez de ser rejeitado.
ARGON2_MAX_QUEUE=64

# ===================================================================
# SEGURANÇA - BCRYPT
# ===================================================================
BCRYPT_SALT_ROUNDS=12

# ===================================================================
# CORS
# ===================================================================
# URLs permitidas (separadas por vírgula)
ALLOWED_ORIGINS=https://app.suaempresa.com

# ===================================================================
# RATE LIMITING (prefixo RATE_LIMIT_PROD_* é o de produção)
# ===================================================================
RATE_LIMIT_PROD_IP_POINTS=100
RATE_LIMIT_PROD_IP_DURATION=60
RATE_LIMIT_PROD_LOGIN_POINTS=5
RATE_LIMIT_PROD_LOGIN_DURATION=900

# ===================================================================
# MONITORAMENTO
# ===================================================================
# Obrigatório em produção: protege GET /observability com header x-metrics-token.
METRICS_TOKEN=troque-por-um-token-aleatorio
SECURITY_DASHBOARD_TOKEN=troque-por-um-token-aleatorio-de-no-minimo-32
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_ENDPOINT=/health

# ===================================================================
# LOGGING
# ===================================================================
LOG_LEVEL=info
LOG_FORMAT=structured

# ===================================================================
# FEATURES
# ===================================================================
SWAGGER_ENABLED=true