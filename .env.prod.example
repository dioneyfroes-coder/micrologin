# ===================================================================
# CONFIGURAÃ‡ÃƒO DE PRODUÃ‡ÃƒO - Exemplo de .env.prod
# ===================================================================
# Copie este arquivo para .env.prod e preencha com valores REAIS.
# NUNCA comite o arquivo .env.prod real no repositÃ³rio.
# Use um gerenciador de segredos (Vault, GitHub Secrets, KMS) na prÃ¡tica.
# VariÃ¡veis listadas sÃ£o as efetivamente consumidas pela aplicaÃ§Ã£o
# (src/interfaces/config/*.ts) e pelo docker-compose.prod.yml.

# ===================================================================
# DOCKER REGISTRY (usado pelo docker-compose.prod.yml)
# ===================================================================
REGISTRY=ghcr.io/SEU-USUARIO
IMAGE_NAME=auth-service
VERSION=latest
# Opcional: o snapshot usa hostname do container quando nÃ£o definido.
# INSTANCE_ID=auth-service-a

# URL pÃºblica da API (termina no proxy/orquestrador). Usada pelo healthcheck
# pÃ³s-deploy do scripts/deploy.sh (produÃ§Ã£o).
PROD_BASE_URL=https://api.suaempresa.com

# APP_PORT publica HTTP e redireciona para HTTPS na porta padrÃ£o 443.
# PROXY_TLS_CERT_DIR deve conter fullchain.pem e privkey.pem provisionados fora
# do git (ou montados pelo gerenciador de certificados do host).
APP_PORT=80
PROXY_TLS_CERT_DIR=./secrets/tls

# ===================================================================
# APLICAÃ‡ÃƒO
# ===================================================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# TLS Ã© terminado no proxy/orquestrador, entÃ£o o app roda em HTTP.
SSL_ENABLED=false
# Um salto: o nginx sobrescreve X-Forwarded-For com o IP real do cliente e Ã© o
# Ãºnico que alcanÃ§a a rede da aplicaÃ§Ã£o. `true` (confiar em toda a cadeia) faz o
# app recusar o arranque, porque nada dentro do processo consegue verificar se
# existe um proxy reescrevendo esse cabeÃ§alho.
TRUST_PROXY=1
# SÃ³ se a sua topologia NÃƒO tem proxy reverso reescrevendo X-Forwarded-For mas o
# app ainda assim nÃ£o Ã© alcanÃ§Ã¡vel por fora da rede confiÃ¡vel:
# TRUST_PROXY_ALLOW_UNRESTRICTED=true
# Se o app precisar servir HTTPS sozinho, informe os certificados e
# monte-os no container:
# SSL_KEY_PATH=/app/certs/server.key
# SSL_CERT_PATH=/app/certs/server.crt

# O container jÃ¡ Ã© uma unidade escalÃ¡vel (docker compose --scale/kubernetes);
# deixe o clustering interno desligado.
CLUSTER_ENABLED=false
# CLUSTER_WORKERS=4
# CLUSTER_MAX_WORKERS=8
# CLUSTER_RESPAWN_DELAY=1000

# ===================================================================
# TIMEOUTS
# ===================================================================
SERVER_TIMEOUT=30000
HTTP_HEADERS_TIMEOUT=15000
HTTP_REQUEST_TIMEOUT=30000
HTTP_KEEP_ALIVE_TIMEOUT=5000
HTTP_CONNECTIONS_CHECKING_INTERVAL=1000
HTTP_LISTEN_BACKLOG=1024
HTTP_MAX_REQUESTS_PER_SOCKET=1000
HTTP_MAX_HEADERS_COUNT=100
GRACEFUL_SHUTDOWN_TIMEOUT=10000
NET_CORE_SOMAXCONN=4096

# ===================================================================
# MONGODB
# ===================================================================
# Dois modos vÃ¡lidos; o app recusa o arranque em produÃ§Ã£o sem credencial (D18).
#
# MODO A â€” Mongo do prÃ³prio docker-compose.prod.yml (padrÃ£o):
#   o serviÃ§o `mongodb` cria o usuÃ¡rio da aplicaÃ§Ã£o na primeira inicializaÃ§Ã£o do
#   volume, em authSource=admin, com papel readWrite sÃ³ sobre o banco do serviÃ§o.
#   A URI nÃ£o carrega senha: ela vem por arquivo.
# URI_MONGODB=mongodb://mongodb:27017/auth_prod
# MONGODB_USER=auth-service
# MONGODB_PASSWORD_PATH=/run/secrets/deps/mongo-app-password
# MONGODB_AUTH_SOURCE=admin
#
# MODO B â€” Mongo gerenciado (Atlas etc.):
#   apague o serviÃ§o `mongodb` do compose, aponte a URI para o host gerenciado e
#   exija TLS. A senha continua fora da URI, quando o provedor aceitar usuÃ¡rio
#   separado; se ela vier embutida na URI, MONGODB_USER/PASSWORD ficam vazias.
# URI_MONGODB=mongodb+srv://cluster.mongodb.net/auth-service
# MONGODB_USER=auth-service
# MONGODB_PASSWORD_PATH=/run/secrets/deps/mongo-app-password
# MONGODB_TLS=true
URI_MONGODB=mongodb://mongodb:27017/auth_prod
MONGODB_USER=auth-service
MONGODB_PASSWORD_PATH=/run/secrets/deps/mongo-app-password
MONGODB_AUTH_SOURCE=admin
MONGODB_MAX_POOL_SIZE=25
MONGODB_TIMEOUT=10000
# MONGODB_SOCKET_TIMEOUT=45000
# MONGODB_TLS=true

# ===================================================================
# REDIS (CACHE, BLACKLIST DE JWT E RATE LIMIT)
# ===================================================================
# MODO A â€” Redis do prÃ³prio compose (padrÃ£o): ACL por arquivo, com
# `user default off`. A senha vem por arquivo, nÃ£o na URL.
# REDIS_URL=redis://redis:6379/0
# REDIS_USERNAME=auth-service
# REDIS_PASSWORD_PATH=/run/secrets/deps/redis-password
#
# MODO B â€” Redis gerenciado (ElastiCache etc.): apague o serviÃ§o `redis` do
# compose, use `rediss://` e/ou REDIS_TLS=true.
REDIS_URL=redis://redis:6379/0
REDIS_USERNAME=auth-service
REDIS_PASSWORD_PATH=/run/secrets/deps/redis-password
REDIS_ENABLED=true
# Fallback usado apenas quando REDIS_URL nÃ£o estÃ¡ definida:
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
REDIS_TTL=3600
# REDIS_TLS=true

# ===================================================================
# TRANSPORTE ATÃ‰ AS DEPENDÃŠNCIAS (decisÃ£o D18)
# ===================================================================
# BinÃ¡rio de propÃ³sito: TLS no caminho OU rede dedicada sem porta publicada.
# O compose padrÃ£o usa a rede `deps-network` (internal, sem gateway) e por isso
# declara o isolamento aqui. Ao apontar para serviÃ§o gerenciado, troque por
# MONGODB_TLS/REDIS_TLS e remova esta linha â€” as duas ao mesmo tempo nÃ£o Ã© uma
# opÃ§Ã£o, e "nenhuma das duas" nÃ£o arranca.
DEPENDENCY_NETWORK_ISOLATED=true

# ===================================================================
# SEGURANÃ‡A - JWT
# ===================================================================
# Algoritmo de assinatura. ES256 (assimetrico) e o unico aceito em producao:
# quem assina tem a chave privada, quem verifica so a publica. HS256 exigiria
# que todo processo que valida um token guardasse o segredo de assinatura.
JWT_ALGORITHM=ES256

# Gere o par no diretorio do HOST, e NAO em /run/secrets: esse e o caminho
# DENTRO do container. O comando precisa de --for-container porque o app roda
# como uid 1001 (nodeuser) e o bind mount carrega o dono do host â€” um par em
# modo 600 do usuario que provisionou seria ilegivel la dentro, e o servico
# recusaria arrancar dizendo que a chave falta, quando ela esta ali.
#   scripts/generate-jwt-keys.sh /run/secrets-host/jwt 2026-q3 --for-container
# A chave privada nao vira texto de configuracao: monte-a como arquivo.
#
# JWT_ES256_KEYS_DIR e o diretorio do HOST com o par. O compose monta esse
# diretorio em /run/secrets (somente leitura) e o app le pelo caminho.
JWT_ES256_KEYS_DIR=/run/secrets-host/jwt
JWT_ES256_KID=2026-q3
JWT_ES256_PRIVATE_KEY_PATH=/run/secrets/jwt-es256-private.pem
JWT_ES256_PUBLIC_KEY_PATH=/run/secrets/jwt-es256-public.pem

# Rotacao de chave (opcional, e temporaria por definicao): a chave anterior
# continua verificando os tokens que ainda estao vivos, entao trocar a chave
# nao derruba quem esta logado. Depois que os tokens da chave antiga expiram,
# remova estas duas variaveis.
# JWT_ES256_PREVIOUS_KID=2026-q2
# JWT_ES256_PREVIOUS_PUBLIC_KEY_PATH=/run/secrets/jwt-es256-public-anterior.pem

# Alternativa sem arquivo, para quem nao tem volume de secrets: o PEM com
# \n literal ou o base64 do PEM. Menos recomendado: chave em texto de config.
# JWT_ES256_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n
# JWT_ES256_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----\n

JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_ISSUER=auth-service
JWT_AUDIENCE=api-users

# Legado HS256 (apenas dev/test; producao recusa no STARTUP):
# JWT_SECRET=troque-por-uma-chave-aleatoria-de-pelo-menos-48-bytes
# JWT_REFRESH_SECRET=outra-chave-aleatoria-diferente-da-anterior-48-bytes

# ===================================================================
# SEGURANÃ‡A - SESSÃƒO / REVOGAÃ‡ÃƒO
# ===================================================================
# PolÃ­tica quando o Redis (blacklist) estÃ¡ indisponÃ­vel:
#   false (padrÃ£o em produÃ§Ã£o) = fail-closed: nega operaÃ§Ãµes que dependem
#                                de revogaÃ§Ã£o, preservando a seguranÃ§a.
#   true = fail-open: mantÃ©m disponibilidade, aceitando tokens revogados.
SESSION_FAIL_OPEN=false

# ===================================================================
# SEGURANÃ‡A - HASH DE SENDA (argon2id)
# ===================================================================
# configuraÃ§Ã£o e nÃ£o tem efeito).
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=1
ARGON2_PARALLELISM=1

# Teto de hashes argon2id SIMULTÃ‚NEOS por processo. Ã‰ o nÃºmero que o orÃ§amento
# de memÃ³ria multiplica por ARGON2_MEMORY_COST para decidir se o container
# aguenta (768 MiB), entÃ£o mudar um sem o outro recusa o arranque.
#
# 8 Ã© a concorrÃªncia que o serviÃ§o entrega sem fila perceptÃ­vel, e com m=64MiB
# sÃ£o 512 MiB dos 768 MiB. Subir este nÃºmero sem baixar ARGON2_MEMORY_COST
# derruba o serviÃ§o no arranque; baixar sem querer faz o login enfileirar.
ARGON2_MAX_CONCURRENCY=8

# Profundidade da fila de espera antes de recusar com 503. Hash argon2 Ã©
# trabalho legÃ­timo, entÃ£o o excesso espera em vez de ser rejeitado.
ARGON2_MAX_QUEUE=64

# ===================================================================
# SEGURANÃ‡A - PEPPER (HMAC-SHA256 antes do hash)
# ===================================================================
# Desligado por padrÃ£o (D17): o mecanismo estÃ¡ implementado e testado, mas sÃ³
# deve ser ligado junto com um KMS que garanta o segredo e a rotaÃ§Ã£o. Sem isso
# seria teatro de seguranÃ§a. Veja docs/ROTACAO.md, seÃ§Ã£o 2, para o procedimento.
#
# A versÃ£o Ã© obrigatÃ³ria se o pepper estiver ligado: sem ela nÃ£o hÃ¡ como dizer,
# anos depois, com qual segredo aquele hash foi feito, e ativar ou rotacionar
# passaria a bloquear todo mundo. VersÃ£o de pepper cujo segredo nÃ£o estÃ¡
# configurado faz o arranque falhar alto, em vez de responder "senha incorreta".
#
# Os dois Ãºltimos sÃ³ existem durante a rotaÃ§Ã£o: cada login bem-sucedido
# reescreve o hash com o pepper atual, e a janela fecha quando o TTL de
# expiraÃ§Ã£o das senhas + a Ãºltima conta ativa tiverem passado por um login.
# PASSWORD_PEPPER=
# PASSWORD_PEPPER_VERSION=p1
# PASSWORD_PEPPER_PREVIOUS=
# PASSWORD_PEPPER_PREVIOUS_VERSION=

# ===================================================================
# ===================================================================

# ===================================================================
# CORS
# ===================================================================
# URLs permitidas (separadas por vÃ­rgula)
ALLOWED_ORIGINS=https://app.suaempresa.com

# ===================================================================
# RATE LIMITING (prefixo RATE_LIMIT_PROD_* Ã© o de produÃ§Ã£o)
# ===================================================================
RATE_LIMIT_PROD_IP_POINTS=100
RATE_LIMIT_PROD_IP_DURATION=60
RATE_LIMIT_PROD_LOGIN_POINTS=5
RATE_LIMIT_PROD_LOGIN_DURATION=900

# ===================================================================
# MONITORAMENTO
# ===================================================================
# ObrigatÃ³rio em produÃ§Ã£o: protege GET /observability com header x-metrics-token.
METRICS_TOKEN=troque-por-um-token-aleatorio
SECURITY_DASHBOARD_TOKEN=troque-por-um-token-aleatorio-de-no-minimo-32
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_ENDPOINT=/health

# ===================================================================
# LOGGING
# ===================================================================
LOG_LEVEL=info
LOG_FORMAT=structured

# ===================================================================
# FEATURES
# ===================================================================
SWAGGER_ENABLED=true
