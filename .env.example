# ===================================================================
# CONFIGURAÇÃO DA APLICAÇÃO - Exemplo de .env
# ===================================================================
# Copie este arquivo para .env e configure conforme necessário

# ===================================================================
# SERVIDOR
# ===================================================================
PORT=3443
HOST=localhost
NODE_ENV=development

# ===================================================================
# DOCKER COMPOSE - PORTAS DO HOST (fonte da verdade)
# ===================================================================
# O docker-compose.yml (dev e prod) publica essas portas no host.
# Se alguma já estiver em uso, rode `scripts/next-port.sh` que soma +1
# até achar a próxima livre; o `scripts/local-deploy.sh` faz isso sozinho
# e atualiza este .env.
APP_PORT=3000
DEBUG_PORT=9229
MONGO_PORT=27017
REDIS_PORT=6379

# ===================================================================
# DOCKER COMPOSE - URIs INTERNAS (services da rede docker)
# ===================================================================
# Usadas APENAS dentro do compose dev, onde mongodb/redis são os hostnames
# dos serviços na rede docker (localhost não existe lá). Altere somente se
# renomear os serviços ou exigir autenticação no mongo/redis locais.
URI_MONGODB_DOCKER=mongodb://mongodb:27017/auth_dev
REDIS_URL_DOCKER=redis://redis:6379/0

# ===================================================================
# SSL/TLS (REMOVER DO CÓDIGO - USAR VARIÁVEL DE AMBIENTE)
# ===================================================================
# Habilitado apenas em produção por padrão. Em dev/test, SSL_ENABLED=true
# exige os certificados abaixo.
SSL_ENABLED=false
SSL_KEY_PATH=./certs/server.key
SSL_CERT_PATH=./certs/server.crt

# ===================================================================
# CLUSTERING
# ===================================================================
# Habilitar clustering (default: ativo em produção, inativo em dev/test)
CLUSTER_ENABLED=false

# Número de workers (padrão: número de CPUs)
# Configure conforme sua necessidade, independente da CPU
CLUSTER_WORKERS=4

# Máximo de workers permitidos
CLUSTER_MAX_WORKERS=8

# Delay antes de recriar worker morto (ms)
CLUSTER_RESPAWN_DELAY=1000

# ===================================================================
# TIMEOUTS
# ===================================================================
# Timeout do servidor (ms)
SERVER_TIMEOUT=30000
# Tempo maximo para receber headers e o request completo (ms).
HTTP_HEADERS_TIMEOUT=15000
HTTP_REQUEST_TIMEOUT=30000
# Politica de keep-alive e teto por conexao HTTP.
HTTP_KEEP_ALIVE_TIMEOUT=5000
HTTP_CONNECTIONS_CHECKING_INTERVAL=1000
HTTP_LISTEN_BACKLOG=1024
HTTP_MAX_REQUESTS_PER_SOCKET=1000
HTTP_MAX_HEADERS_COUNT=100

# Timeout para graceful shutdown (ms)
GRACEFUL_SHUTDOWN_TIMEOUT=5000

# ===================================================================
# PROXY / REDE
# ===================================================================
# Confiança em cabeçalhos de proxy. O padrão é NÃO confiar: X-Forwarded-For
# vem do cliente, e aceitá-lo sem proxy declarado deixa o req.ip (e o rate
# limit por IP) sob controle de quem faz a requisição.
#
#   false | 0 | off | no    → não confiar (padrão, use em dev/test)
#   1 | 2 | ...              → número de saltos de proxy confiáveis
#   10.0.0.0/8,192.168.1.10  → faixas CIDR do proxy confiável
#   true                     → confiar em toda a cadeia (evite)
TRUST_PROXY=false
# Em PRODUÇÃO, TRUST_PROXY=true faz o app recusar o arranque: a confiança em
# toda a cadeia só é segura com um proxy reverso que reescreva
# X-Forwarded-For, e isso é propriedade da topologia, não do processo. Se a sua
# topologia realmente sustenta a afirmação, assuma a responsabilidade de forma
# explícita:
# TRUST_PROXY_ALLOW_UNRESTRICTED=true

# ===================================================================
# BANCO DE DADOS - MONGODB
# ===================================================================
URI_MONGODB=mongodb://localhost:27017/auth-service

# Credencial do Mongo (obrigatória em produção, opcional em dev).
# O usuário recebe readWrite só sobre o banco do serviço, em authSource=admin,
# criado por docker/mongo/10-app-user.sh no primeiro start do volume.
# Prefira MONGODB_PASSWORD_PATH para não deixar a senha no .env.
# MONGODB_USER=auth-service
# MONGODB_PASSWORD=
# MONGODB_PASSWORD_PATH=/run/secrets/deps/mongo-app-password
# MONGODB_AUTH_SOURCE=admin
# MONGODB_TLS=true   # liga TLS até o Mongo (obrigatório fora de rede dedicada)

# Pool de conexões
MONGODB_MAX_POOL_SIZE=10
MONGODB_TIMEOUT=5000
MONGODB_SOCKET_TIMEOUT=45000

# ===================================================================
# REDIS (CACHE)
# ===================================================================
# Forma preferida: uma única URL (como URI_MONGODB), podendo conter senha e db.
# Ex.: redis://usuario:senha@localhost:6379/0
REDIS_URL=
REDIS_ENABLED=true
# Fallback usado apenas quando REDIS_URL não está definida:
REDIS_HOST=localhost
REDIS_PORT=6379
# Usuário de ACL. O compose de produção usa `user default off` + este usuário,
# para a conexão anônima ser recusada e o acesso ser atribuível a alguém.
# REDIS_USERNAME=auth-service
REDIS_PASSWORD=
# REDIS_PASSWORD_PATH=/run/secrets/deps/redis-password
REDIS_DB=0
REDIS_TTL=3600
# REDIS_TLS=true   # liga TLS até o Redis (obrigatório fora de rede dedicada)

# ===================================================================
# SEGURANÇA - JWT
# ===================================================================
# Algoritmo de assinatura:
#   ES256 = assimétrico (produção). Quem assina tem a chave privada; quem
#           verifica só a pública. Gere o par com:
#             scripts/generate-jwt-keys.sh ./keys v1
#           Com docker (compose montando o diretório), acrescente
#           --for-container: o app roda como uid 1001 e o bind mount traz o
#           dono do host, então um par em modo 600 seria ilegível lá dentro.
#   HS256 = simétrico. Só em dev/test: exige que todo processo que verifica um
#           token carregue o segredo que o assina. Produção RECUSA HS256.
JWT_ALGORITHM=HS256

# --- Caminho ES256 (usado quando JWT_ALGORITHM=ES256) ---
# JWT_ES256_KID=v1
# JWT_ES256_PRIVATE_KEY_PATH=./keys/jwt-es256-private.pem
# JWT_ES256_PUBLIC_KEY_PATH=./keys/jwt-es256-public.pem
# Rotação (opcional): a chave anterior continua verificando tokens vivos.
# JWT_ES256_PREVIOUS_KID=v0
# JWT_ES256_PREVIOUS_PUBLIC_KEY_PATH=./keys/jwt-es256-public-anterior.pem
#
# Sem volume de arquivos, use o PEM com \n literal ou o base64 do PEM:
# JWT_ES256_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n
# JWT_ES256_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----\n

# --- HS256 legado (JWT_ALGORITHM=HS256) ---
# IMPORTANTE: Use chaves fortes com pelo menos 32 caracteres
JWT_SECRET=your-super-secret-jwt-key-with-at-least-32-chars-for-security
# Obrigatório e DIFERENTE de JWT_SECRET em produção (sem fallback silencioso):
JWT_REFRESH_SECRET=your-other-refresh-secret-with-32-chars-minimum
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_ISSUER=auth-service
JWT_AUDIENCE=api-users

# ===================================================================
# SEGURANÇA - SESSÃO / REVOGAÇÃO
# ===================================================================
# Política quando o Redis (blacklist de revogação) está indisponível:
#   false (padrão em produção) = fail-closed: nega login/refresh/logout e a
#                                validação de tokens em vez de aceitar sem
#                                controle de revogação.
#   true  (padrão em dev/test) = fail-open: mantém disponibilidade, aceitando
#                                que tokens revogados não sejam barrados.
# Em produção, o padrão fail-closed é fortemente recomendado.
SESSION_FAIL_OPEN=

# ===================================================================
# SEGURANÇA - HASH DE SENHA (argon2id, ver D16)
# ===================================================================
# Parâmetros do argon2id. O algoritmo é fixo: argon2id é o único caminho de
# gravação e de verificação, então não há variável de ambiente para ele.
#
# A verificação lê os parâmetros do hash guardado, então subir `memoryCost` ou
# `timeCost` reescreve cada usuário no login seguinte, sem travar ninguém.
#
# Os padrões (m=64MiB, t=1, p=1) foram medidos no orçamento real do serviço
# (server01: i5-7200U, 2.0 CPU de orçamento, 1 GiB). A escolha segue o recurso
# escasso de cada lado: para um atacante com GPU, memória por tentativa é o
# gargalo (VRAM é caro e não cresce como FLOPS), enquanto tempo é barato e
# paraleliza. Então o esforço vai para m, não para t.
#
#   memoryCost  KiB de memória por hash. 65536 = 64 MiB.
#               Medido: 3.4x a memória por tentativa dos m=19MiB da OWASP,
#               com a MESMA latência de login (p95 de 81 ms contra 84 ms).
#   timeCost    passadas sobre a memória. t=1 é o ponto em que m já é o
#               gargalo do atacante; subir para t=2 dobra o custo dos dois
#               lados e empurra o p95 para 173 ms sem benefit proportional.
#   parallelism threads por hash. p > 1 entrega poder computacional ao atacante
#               sem devolver defesa proporcional, e em servidor esse poder sai
#               do orçamento de latência em vez de entrar. Medido no server01:
#               p=4 entrega 20 logins/s contra 29 do p=1 no mesmo m=64MiB —
#               pior, porque o paralelismo divide o mesmo CPU. A OWASP pede
#               p=1 em servidor.
#
# O arranque recusa o que não cabe: memoryCost × ARGON2_MAX_CONCURRENCY hashes
# simultâneos tem que caber no orçamento de memória do container, que é 768 MiB
# (1 GiB de mem_limit menos a folga do runtime). Com m=64MiB e teto 8, são
# 512 MiB e sobra ~33% de folga; m=96MiB seria recusado. Acima disso o serviço
# não sobe — é recusado, não avisado, porque o resultado em produção seria OOM
# no meio do tráfego. A medição que define cada número está em docs/metricas.md.
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=1
ARGON2_PARALLELISM=1

# Teto de operações argon2id SIMULTÂNEAS por processo (não de requisições).
#
# Este é o limite que o orçamento acima usa na conta: os dois números são o
# mesmo, e é por isso que a validação acima acompanha esta variável. Antes da
# 1.0.0 o "8" era uma constante usada só na conta — nada o impunha em runtime,
# então um burst de login produzia 200 hashes ao mesmo tempo dentro de um
# container orçado para 8.
#
# É independente de MAX_IN_FLIGHT_REQUESTS, e os dois ficam de pé: o in-flight
# conta requisições HTTP abertas (protege o servidor de rajada); este conta
# hashes concorrentes (protege a memória, que é onde o argon2id realmente pesa).
#
# Reduzir este número reduz o pico de memória e aumenta a latência de fila do
# login; o padrão 8 é a concorrência que o serviço entrega sem fila perceptível.
ARGON2_MAX_CONCURRENCY=8

# Profundidade da fila de espera do teto acima. Um hash argon2 é trabalho
# legítimo de usuário legítimo, então o excesso é ENFILEIRADO, não recusado; só
# a fila cheia recusa (503 com Retry-After). Fila sem fundo converteria
# sobrecarga em latência que ninguém explica depois.
ARGON2_MAX_QUEUE=64

# Pepper: HMAC-SHA256 aplicado antes do hash, com a versão gravada dentro do
# próprio hash (envelope `p1:$argon2id$...`). Desligado por padrão (ver D17):
# o mecanismo está implementado e testado, mas só deve ser ligado junto com um
# KMS que garanta o segredo e a rotação.
#
# A versão é obrigatória se o pepper estiver ligado: sem ela não há como dizer,
# anos depois, com qual segredo aquele hash foi feito, e ativar ou rotacionar
# passaria a bloquear todo mundo.
#
# Pepper anterior, só para verificar hashes já gravados. Mantenha durante a
# rotação; cada login bem-sucedido reescreve o hash com o pepper atual.
PASSWORD_PEPPER=
PASSWORD_PEPPER_VERSION=p1
PASSWORD_PEPPER_PREVIOUS=
PASSWORD_PEPPER_PREVIOUS_VERSION=

# ===================================================================
# CORS (REMOVER DO CÓDIGO - USAR VARIÁVEL DE AMBIENTE)
# ===================================================================
# URLs permitidas para CORS (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000

# ===================================================================
# MONITORAMENTO
# ===================================================================
# Token opcional que protege o manifesto de observabilidade (header
# x-metrics-token). Em produção, configure um token: o manifesto expõe volumes,
# latência e estatísticas de segurança.
METRICS_TOKEN=
SECURITY_DASHBOARD_TOKEN=

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_ENDPOINT=/health

# ===================================================================
# LOGGING
# ===================================================================
LOG_LEVEL=info
LOG_FORMAT=console
# LOG_FORMAT=structured  # Para logs em JSON estruturado

# ===================================================================
# FEATURES (DESENVOLVIMENTO)
# ===================================================================
# Documentação Swagger
SWAGGER_ENABLED=true

# ===================================================================
# RATE LIMITING
# ===================================================================
# Defaults em src/interfaces/config/rateLimitConfig.ts (dev/prod).
# O compose dev injeta no container RATE_LIMIT_IP_POINTS e
# RATE_LIMIT_LOGIN_POINTS (com os defaults 1000/100); sobrescreva aqui:
RATE_LIMIT_IP_POINTS=1000
RATE_LIMIT_LOGIN_POINTS=100
# Para produção use o prefixo RATE_LIMIT_PROD_* (ex.: RATE_LIMIT_PROD_LOGIN_POINTS=5).

# ===================================================================
# NOTAS DE SEGURANÇA
# ===================================================================
# 1. NUNCA comite este arquivo .env no Git
# 2. Use ES256 em produção; HS256 é recusado no STARTUP
# 3. Configure SSL em produção
# 4. Use variáveis de ambiente do sistema em produção
# 5. Configure firewall e rede adequadamente
# 6. NUNCA versione a chave privada (jwt-es256-private.pem)
