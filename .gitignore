node_modules
server.crt
server.key
.env
.env.dev
.env.test
.env.prod
.env.docker

# Chaves de assinatura ES256: material privado nunca entra no repositorio
keys/
secrets/
.resilience-keys/
.resilience-deps/
# Material efêmero dos drills de backup (2.1) e de persistência do Redis (2.2):
# chaves ES256 e credenciais geradas na hora, apagadas no teardown.
.backup-keys/
.backup-deps/
.redis-keys/
.redis-deps/
# Material do drill de configuração (2.3) e backups reais de configuração.
.cfg-secrets/
.cfg-backups/
.cfg-test.env
.cfg-passphrase
cfg-backups/
deploy-config-backup.log
deploy-drill.env

# Material efêmero do drill de deploy (scripts/test-deploy.sh): chaves ES256
# e credenciais de dependência em texto claro, por necessidade do roteiro. O
# drill apaga o diretório no fim, mas um Ctrl+C no meio deixaria segredo em disco.
.deploy-drill/
.deploy-drill.lock
backups/
*.pem
# `*.pem` acima não cobre `server.key`, então o diretório inteiro é ignorado:
# certificado de dev não vai para o git, e a chave privada muito menos.
certs/

dist
build
coverage/
.DS_Store
npm-debug.log
ignore.js
logs/

# Saida bruta das corridas de capacidade (Fase 3.1). Sao relatorios de um
# ambiente especifico (2.0 CPU, 1 GiB, um worker) e nao pertencem ao historico:
# o que entra no repositorio e a tabela interpretada em docs/metricas.md.
artifacts/

# Byte-compilado de Python gerado quando o consolidado da medicao roda.
# Nao e fonte: versionar .pyc guarda artefato de build no repositorio.
__pycache__/
*.pyc

# Persistencia local do Redis em execucao na maquina de dev: o dump fica ao
# lado do diretorio de trabalho e nao e fonte. Em producao a persistencia e
# controlada pelo compose/runbook, nao por um arquivo versionado.
*.rdb
*.aof
