{
  "name": "autentication",
  "version": "1.0.0",
  "description": "API de autenticação em Node.js para estudo de arquitetura, segurança e organização de código",
  "main": "dist/app.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node dist/app.js",
    "dev": "cross-env NODE_ENV=development tsx src/app.ts",
    "stop": "pm2 stop autenticacao",
    "restart": "pm2 restart autenticacao",
    "logs": "pm2 logs autenticacao",
    "status": "pm2 status",
    "build": "tsc",
    "build:pm2": "cross-env NODE_ENV=production pm2 start ecosystem.config.cjs",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=\"--experimental-vm-modules\" jest --detectOpenHandles --forceExit",
    "test:unit": "cross-env NODE_ENV=test NODE_OPTIONS=\"--experimental-vm-modules\" jest tests/unit --detectOpenHandles --forceExit",
    "test:integration": "cross-env NODE_ENV=test NODE_OPTIONS=\"--experimental-vm-modules\" jest tests/integration --detectOpenHandles --forceExit",
    "test:coverage": "cross-env NODE_ENV=test NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage --detectOpenHandles --forceExit",
    "test:unit:fast": "cross-env NODE_ENV=test NODE_OPTIONS=\"--experimental-vm-modules\" jest tests/unit --detectOpenHandles --forceExit --runInBand",
    "test:integration:app": "cross-env NODE_ENV=test NODE_OPTIONS=\"--experimental-vm-modules\" jest tests/integration --detectOpenHandles --forceExit --runInBand",
    "test:coverage:fast": "cross-env NODE_ENV=test NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage --detectOpenHandles --forceExit --runInBand",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:watch": "cross-env NODE_ENV=test NODE_OPTIONS=\"--experimental-vm-modules\" jest --watch --detectOpenHandles",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint src/ tests/ --fix",
    "audit": "npm audit",
    "build:docker": "docker build -t auth-service .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "nodejs",
    "authentication",
    "microservice",
    "jwt",
    "security",
    "hexagonal-architecture",
    "express",
    "clustering"
  ],
  "author": "Dioney Froes",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "isomorphic-dompurify": "^2.25.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pm2": "^7.0.4",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^7.1.1",
    "redis": "^5.5.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.15"
  },
  "type": "module",
  "devDependencies": {
    "@babel/core": "^7.27.7",
    "@babel/preset-env": "^7.27.2",
    "@eslint/js": "^9.30.1",
    "@jest/globals": "^30.0.3",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/validator": "^13.15.10",
    "audit-ci": "^7.1.0",
    "babel-jest": "^30.0.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.30.1",
    "jest": "^30.0.3",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.13",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.70.1"
  }
}
